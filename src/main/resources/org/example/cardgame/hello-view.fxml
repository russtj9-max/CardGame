<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="455.0" prefWidth="1150.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cardgame.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

   <AnchorPane prefHeight="411.0" prefWidth="1110.0">
      <children>
          <Button layoutX="1037.0" layoutY="298.0" onAction="#onVerifyButtonClick" text="Verify" />
          <Button layoutX="1032.0" layoutY="28.0" onAction="#onRefreshButtonClick" text="Refresh" />
         <TextField fx:id="resultField" layoutX="800.0" layoutY="28.0" prefHeight="25.0" prefWidth="229.0" promptText="Result" />
         <TextField fx:id="equationInput" layoutX="800.0" layoutY="298.0" prefHeight="25.0" prefWidth="229.0" promptText="Enter Equation" />
         <Label layoutX="800.0" layoutY="260.0" prefHeight="28.0" prefWidth="120.0" text="Equation:">
            <font>
               <Font name="System Bold" size="19.0" />
            </font>
         </Label>
          <ImageView fx:id="cardImage1" fitHeight="242.0" fitWidth="170.0" layoutX="25.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true" />
          <ImageView fx:id="cardImage2" fitHeight="242.0" fitWidth="170.0" layoutX="210.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true" />
          <ImageView fx:id="cardImage3" fitHeight="242.0" fitWidth="170.0" layoutX="395.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true" />
          <ImageView fx:id="cardImage4" fitHeight="242.0" fitWidth="170.0" layoutX="580.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true" />
      </children>
   </AnchorPane>
</VBox>
